--- a/examples/typescript/src/app.test.ts
+++ b/examples/typescript/src/app.test.ts
@@ -36,14 +36,61 @@ test("totals an order", () => {
 
 test("loads orders in order", async () => {
   const store: OrderStore = {
-    async findById(id) {
-      return { id, total: 1 };
+    async findByIds(ids) {
+      return ids.map((id) => ({ id, total: 1 }));
     },
   };
   const orders = await loadOrders(store, ["a", "b"]);
   assert.deepEqual(orders.map((o) => o.id), ["a", "b"]);
 });
 
+test("issues exactly one store query per request", async () => {
+  let queryCount = 0;
+  const store: OrderStore = {
+    async findByIds(ids) {
+      queryCount += 1;
+      return ids.map((id) => ({ id, total: 1 }));
+    },
+  };
+
+  const orders = await loadOrders(store, ["a", "b", "c"]);
+  assert.equal(orders.length, 3);
+  assert.equal(queryCount, 1, "a request must issue exactly one store query");
+
+  queryCount = 0;
+  assert.deepEqual(await loadOrders(store, []), []);
+  assert.equal(queryCount, 0, "an empty request must not query the store");
+});
+
+test("preserves requested order and duplicates", async () => {
+  const store: OrderStore = {
+    async findByIds(ids) {
+      return ids.map((id) => ({ id, total: id.length }));
+    },
+  };
+  const orders = await loadOrders(store, ["bb", "a", "bb"]);
+  assert.deepEqual(
+    orders.map((o) => [o.id, o.total]),
+    [
+      ["bb", 2],
+      ["a", 1],
+      ["bb", 2],
+    ],
+  );
+});
+
+test("reports the first missing identifier in request order", async () => {
+  const store: OrderStore = {
+    async findByIds(ids) {
+      return ids.filter((id) => id !== "missing-a" && id !== "missing-b").map((id) => ({ id, total: 1 }));
+    },
+  };
+  await assert.rejects(loadOrders(store, ["kept", "missing-a", "missing-b"]), {
+    name: "Error",
+    message: "order not found: missing-a",
+  });
+});
+
 test("resolves a normal file name", () => {
   assert.equal(resolveUserFile("avatar.png"), `${BASE_DIR}/avatar.png`);
 });
