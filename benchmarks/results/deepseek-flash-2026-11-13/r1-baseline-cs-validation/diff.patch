+/// <summary>Create-user response returned for accepted requests.</summary>
+/// <param name="Email">Validated email address.</param>
+/// <param name="Name">Validated display name.</param>
+/// <param name="Age">Optional validated age.</param>
+public sealed record CreateUserResponse(string? Email, string? Name, int? Age);
+
+/// <summary>HTTP endpoint that validates create-user requests.</summary>
+public static class UserEndpoint
+{
+    /// <summary>Route template for the create-user endpoint.</summary>
+    public const string Route = "/users";
+
+    /// <summary>Problem title used when request fields fail validation.</summary>
+    public const string ValidationProblemTitle = "One or more validation errors occurred.";
+
+    /// <summary>Problem title used when the request body is not valid JSON.</summary>
+    public const string MalformedPayloadTitle = "The request payload is malformed.";
+
+    /// <summary>Problem title used when the request body is not JSON.</summary>
+    public const string UnsupportedContentTypeTitle = "The request content type is not supported.";
+
+    /// <summary>Problem extension key that carries validation errors.</summary>
+    public const string ValidationErrorsKey = "errors";
+
+    /// <summary>Handles a create-user request.</summary>
+    /// <param name="request">Incoming HTTP request whose body contains JSON.</param>
+    /// <returns>
+    /// <c>200</c> with the accepted user, <c>400</c> with a problem response for malformed or
+    /// invalid JSON, or <c>415</c> with a problem response for a non-JSON content type.
+    /// </returns>
+    public static async Task<IResult> CreateUserAsync(HttpRequest request)
+    {
+        CreateUserRequest? payload;
+
+        try
+        {
+            payload = await request.ReadFromJsonAsync<CreateUserRequest>();
+        }
+        catch (JsonException)
+        {
+            return MalformedPayloadResult();
+        }
+        catch (InvalidOperationException)
+        {
+            return UnsupportedContentTypeResult();
+        }
+
+        if (payload is null)
+        {
+            return MalformedPayloadResult();
+        }
+
+        var errors = Validator.Validate(payload);
+
+        if (errors.Count > 0)
+        {
+            return TypedResults.Problem(
+                title: ValidationProblemTitle,
+                statusCode: StatusCodes.Status400BadRequest,
+                extensions: new Dictionary<string, object?> { [ValidationErrorsKey] = errors });
+        }
+
+        return TypedResults.Ok(new CreateUserResponse(payload.Email, payload.Name, payload.Age));
+    }
+
+    private static ProblemHttpResult MalformedPayloadResult()
+        => TypedResults.Problem(
+            title: MalformedPayloadTitle,
+            statusCode: StatusCodes.Status400BadRequest);
+
+    private static ProblemHttpResult UnsupportedContentTypeResult()
+        => TypedResults.Problem(
+            title: UnsupportedContentTypeTitle,
+            statusCode: StatusCodes.Status415UnsupportedMediaType);
+}
