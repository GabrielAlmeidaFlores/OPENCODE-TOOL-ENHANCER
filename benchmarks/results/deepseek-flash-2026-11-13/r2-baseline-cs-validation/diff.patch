+/// <summary>HTTP-facing create-user endpoint.</summary>
+public static class CreateUserEndpoint
+{
+    private const string InvalidRequestTitle = "Invalid request";
+    private const string MissingBodyDetail = "A request body is required.";
+    private const string MalformedBodyDetail = "The request body is not valid JSON.";
+
+    private static readonly JsonSerializerOptions JsonOptions = new()
+    {
+        PropertyNameCaseInsensitive = true
+    };
+
+    /// <summary>Handles a bound create-user request.</summary>
+    /// <param name="request">Request data bound from the payload, or null when the payload is missing.</param>
+    /// <returns>A 201 response for valid input; otherwise an RFC 7807 problem response.</returns>
+    /// <remarks>A request that passes <see cref="Validator.Validate"/> has a non-null email.</remarks>
+    public static IResult Handle(CreateUserRequest? request)
+    {
+        if (request is null)
+        {
+            return Results.Problem(
+                title: InvalidRequestTitle,
+                detail: MissingBodyDetail,
+                statusCode: StatusCodes.Status400BadRequest);
+        }
+
+        var errors = Validator.Validate(request);
+        if (errors.Count > 0)
+        {
+            return Results.Problem(
+                title: InvalidRequestTitle,
+                detail: string.Join("; ", errors),
+                statusCode: StatusCodes.Status400BadRequest);
+        }
+
+        return Results.Created($"/users/{Uri.EscapeDataString(request.Email!)}", request);
+    }
+
+    /// <summary>Parses and handles a raw create-user payload.</summary>
+    /// <param name="body">Raw request body, or null when the payload is missing.</param>
+    /// <returns>A 201 response for valid input; otherwise an RFC 7807 problem response.</returns>
+    public static IResult HandleJson(string? body)
+    {
+        if (string.IsNullOrWhiteSpace(body))
+        {
+            return Handle(null);
+        }
+
+        CreateUserRequest? request;
+        try
+        {
+            request = JsonSerializer.Deserialize<CreateUserRequest>(body, JsonOptions);
+        }
+        catch (JsonException)
+        {
+            return Results.Problem(
+                title: InvalidRequestTitle,
+                detail: MalformedBodyDetail,
+                statusCode: StatusCodes.Status400BadRequest);
+        }
+
+        return Handle(request);
+    }
+}
