diff --git a/examples/typescript/src/files.ts b/examples/typescript/src/files.ts
index 642f872..dcaf733 100644
--- a/examples/typescript/src/files.ts
+++ b/examples/typescript/src/files.ts
@@ -1,15 +1,47 @@
-import { join } from "node:path";
+import { isAbsolute, relative, resolve, sep } from "node:path";
 
 /** Base directory used by {@link resolveUserFile}. */
 export const BASE_DIR = "/srv/user-files";
 
+/** Message thrown when a name escapes {@link BASE_DIR}. */
+export const INVALID_FILE_NAME_MESSAGE = "file name resolves outside the base directory";
+
+/**
+ * Decodes percent-encoded input once so encoded traversal is checked like plain traversal.
+ *
+ * @param name - User-supplied file name, possibly percent-encoded.
+ * @returns The decoded file name.
+ * @throws Error when the input contains malformed percent encoding.
+ */
+function decodeFileName(name: string): string {
+  try {
+    return decodeURIComponent(name);
+  } catch {
+    throw new Error(INVALID_FILE_NAME_MESSAGE);
+  }
+}
+
 /**
  * Resolves a user-supplied file name under {@link BASE_DIR}.
  *
- * @param name - User-supplied file name.
- * @returns The joined path.
- * @remarks Intentionally vulnerable to path traversal to support the security benchmark task.
+ * @param name - User-supplied file name, possibly percent-encoded.
+ * @returns An absolute path that stays inside {@link BASE_DIR}.
+ * @throws Error when the name is empty, malformed, absolute, or escapes {@link BASE_DIR}.
  */
 export function resolveUserFile(name: string): string {
-  return join(BASE_DIR, name);
+  const decoded = decodeFileName(name);
+  const candidate = resolve(BASE_DIR, decoded);
+  const relativePath = relative(BASE_DIR, candidate);
+
+  const escapesBase =
+    relativePath === "" ||
+    relativePath === ".." ||
+    relativePath.startsWith(`..${sep}`) ||
+    isAbsolute(relativePath);
+
+  if (escapesBase) {
+    throw new Error(INVALID_FILE_NAME_MESSAGE);
+  }
+
+  return candidate;
 }
