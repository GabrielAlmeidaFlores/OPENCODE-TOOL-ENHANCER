+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  AGE_ERROR,
+  BODY_ERROR,
+  EMAIL_ERROR,
+  HTTP_BAD_REQUEST,
+  HTTP_OK,
+  NAME_ERROR,
+  UNKNOWN_FIELD_ERROR_TEMPLATE,
+  FIELD_PLACEHOLDER,
+  createUserEndpoint,
+  validateCreateUser,
+} from "./validation.js";
+
+const VALID_INPUT = { email: "a@b.co", name: "Ada", age: 30 };
+const FIELD_PASSWORD = "password";
+const EMAIL_WITH_PADDING = "  a@b.co  ";
+const NAME_WITH_PADDING = "  Ada  ";
+const MALFORMED_EMAILS: readonly unknown[] = [
+  "not-an-email",
+  "a@b",
+  "@b.co",
+  "a@.co",
+  "a b@c.co",
+  "",
+  42,
+  null,
+];
+const MALFORMED_NAMES: readonly unknown[] = ["", "   ", 7, null];
+const MALFORMED_AGES: readonly unknown[] = [-1, 1.5, "30", Number.NaN, null];
+const MALFORMED_BODIES: readonly unknown[] = [undefined, null, "user", 7, [{ email: "a@b.co" }]];
+
+test("accepts a complete valid request", () => {
+  assert.deepEqual(validateCreateUser(VALID_INPUT), { ok: true, errors: [] });
+});
+
+test("accepts a request without the optional age", () => {
+  const { email, name } = VALID_INPUT;
+  assert.deepEqual(validateCreateUser({ email, name }), { ok: true, errors: [] });
+});
+
+test("trims surrounding whitespace from accepted text fields", () => {
+  const response = createUserEndpoint({ email: EMAIL_WITH_PADDING, name: NAME_WITH_PADDING });
+  assert.deepEqual(response, {
+    status: HTTP_OK,
+    body: { user: { email: "a@b.co", name: "Ada" } },
+  });
+});
+
+test("rejects a missing email", () => {
+  const result = validateCreateUser({ name: "Ada" });
+  assert.equal(result.ok, false);
+  assert.deepEqual(result.errors, [EMAIL_ERROR]);
+});
+
+test("rejects a missing name", () => {
+  const result = validateCreateUser({ email: "a@b.co" });
+  assert.equal(result.ok, false);
+  assert.deepEqual(result.errors, [NAME_ERROR]);
+});
+
+test("rejects a malformed email", () => {
+  for (const email of MALFORMED_EMAILS) {
+    const result = validateCreateUser({ email, name: "Ada" });
+    assert.equal(result.ok, false, `expected ${String(email)} to be rejected`);
+    assert.deepEqual(result.errors, [EMAIL_ERROR], `unexpected errors for ${String(email)}`);
+  }
+});
+
+test("rejects a malformed name", () => {
+  for (const name of MALFORMED_NAMES) {
+    const result = validateCreateUser({ email: "a@b.co", name });
+    assert.equal(result.ok, false, `expected ${String(name)} to be rejected`);
+    assert.deepEqual(result.errors, [NAME_ERROR], `unexpected errors for ${String(name)}`);
+  }
+});
+
+test("rejects a malformed age", () => {
+  for (const age of MALFORMED_AGES) {
+    const result = validateCreateUser({ email: "a@b.co", name: "Ada", age });
+    assert.equal(result.ok, false, `expected ${String(age)} to be rejected`);
+    assert.deepEqual(result.errors, [AGE_ERROR], `unexpected errors for ${String(age)}`);
+  }
+});
+
+test("rejects a body that is not a JSON object", () => {
+  for (const body of MALFORMED_BODIES) {
+    const result = validateCreateUser(body);
+    assert.equal(result.ok, false);
+    assert.deepEqual(result.errors, [BODY_ERROR]);
+  }
+});
+
+test("rejects unsupported fields", () => {
+  const result = validateCreateUser({ ...VALID_INPUT, [FIELD_PASSWORD]: "secret" });
+  assert.equal(result.ok, false);
+  assert.deepEqual(result.errors, [
+    UNKNOWN_FIELD_ERROR_TEMPLATE.replace(FIELD_PLACEHOLDER, FIELD_PASSWORD),
+  ]);
+});
+
+test("reports every failing field at once", () => {
+  const response = createUserEndpoint({ age: -2 });
+  assert.deepEqual(response, {
+    status: HTTP_BAD_REQUEST,
+    body: { errors: [EMAIL_ERROR, NAME_ERROR, AGE_ERROR] },
+  });
+});
+
+test("returns 400 for invalid input", () => {
+  const response = createUserEndpoint({ email: "not-an-email", name: "" });
+  assert.equal(response.status, HTTP_BAD_REQUEST);
+  assert.deepEqual(response.body, { errors: [EMAIL_ERROR, NAME_ERROR] });
+});
+
+test("returns 200 with the normalized user for valid input", () => {
+  const response = createUserEndpoint(VALID_INPUT);
+  assert.deepEqual(response, {
+    status: HTTP_OK,
+    body: { user: { email: "a@b.co", name: "Ada", age: 30 } },
+  });
+});
