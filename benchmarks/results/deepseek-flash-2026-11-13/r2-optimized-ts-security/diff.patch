+++ b/examples/typescript/src/files.ts
@@ -1,15 +1,99 @@
-import { join } from "node:path";
+import { isAbsolute, relative, resolve, sep, win32 } from "node:path";
 
 /** Base directory used by {@link resolveUserFile}. */
 export const BASE_DIR = "/srv/user-files";
 
+/** Message carried by every {@link UnsafeFileNameError}. */
+const UNSAFE_NAME_MESSAGE = "file name must not escape the base directory";
+
+/** Segment that walks up one directory level. */
+const PARENT_SEGMENT = "..";
+
+/** Prefix of any relative path that starts with a parent segment. */
+const PARENT_PREFIX = PARENT_SEGMENT + sep;
+
+/** NUL byte, which truncates paths in native file APIs. */
+const NUL = "\u0000";
+
+/** Separators accepted from POSIX and Windows clients. */
+const SEPARATOR = /[\\/]+/u;
+
+/** Percent-encoded octet, including forms produced by nested URL encoding. */
+const PERCENT_OCTET = /%([\da-f]{2})/giu;
+
+/** Raised when a name would resolve outside {@link BASE_DIR}. */
+export class UnsafeFileNameError extends Error {
+  constructor() {
+    super(UNSAFE_NAME_MESSAGE);
+    this.name = UnsafeFileNameError.name;
+  }
+}
+
+/**
+ * Expands every percent-encoded octet until the value stops changing.
+ *
+ * @param value - Raw or partially encoded candidate.
+ * @returns The fully decoded candidate.
+ * @remarks Each pass replaces one three-character octet with a single
+ * character, so the length strictly decreases and the loop terminates.
+ */
+function fullyDecoded(value: string): string {
+  let decoded = value;
+  for (;;) {
+    const next = decoded.replace(PERCENT_OCTET, (_octet, hex: string) =>
+      String.fromCharCode(Number.parseInt(hex, 16)),
+    );
+    if (next === decoded) {
+      return decoded;
+    }
+    decoded = next;
+  }
+}
+
+/**
+ * Rejects names that are not a relative path below a base directory.
+ *
+ * @param candidate - Raw or decoded name to inspect.
+ * @throws {UnsafeFileNameError} When the name is empty, absolute, contains a
+ * NUL byte, or contains a parent segment.
+ */
+function assertRelativeName(candidate: string): void {
+  const isRejected =
+    candidate.length === 0 ||
+    candidate.includes(NUL) ||
+    isAbsolute(candidate) ||
+    win32.isAbsolute(candidate) ||
+    candidate.split(SEPARATOR).includes(PARENT_SEGMENT);
+  if (isRejected) {
+    throw new UnsafeFileNameError();
+  }
+}
+
 /**
  * Resolves a user-supplied file name under {@link BASE_DIR}.
  *
- * @param name - User-supplied file name.
- * @returns The joined path.
- * @remarks Intentionally vulnerable to path traversal to support the security benchmark task.
+ * @param name - User-supplied file name, read from an untrusted request.
+ * @returns The absolute path of an existing file name inside {@link BASE_DIR}.
+ * @throws {UnsafeFileNameError} When the name is empty, absolute, encoded,
+ * contains a NUL byte or a parent segment, or otherwise escapes
+ * {@link BASE_DIR}.
+ * @remarks The raw name and its fully percent-decoded form are both validated,
+ * and the resolved path is checked for containment, so the returned path never
+ * points outside the base directory.
  */
 export function resolveUserFile(name: string): string {
-  return join(BASE_DIR, name);
+  assertRelativeName(name);
+  assertRelativeName(fullyDecoded(name));
+
+  const resolved = resolve(BASE_DIR, name);
+  const insideBase = relative(BASE_DIR, resolved);
+  const escapes =
+    insideBase.length === 0 ||
+    insideBase === PARENT_SEGMENT ||
+    insideBase.startsWith(PARENT_PREFIX) ||
+    isAbsolute(insideBase);
+  if (escapes) {
+    throw new UnsafeFileNameError();
+  }
+  return resolved;
 }
