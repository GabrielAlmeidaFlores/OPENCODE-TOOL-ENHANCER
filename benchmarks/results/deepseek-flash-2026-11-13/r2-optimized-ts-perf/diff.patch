diff --git a/examples/typescript/src/app.test.ts b/examples/typescript/src/app.test.ts
index 15cd72f..416987e 100644
--- a/examples/typescript/src/app.test.ts
+++ b/examples/typescript/src/app.test.ts
@@ -36,14 +36,64 @@ test("totals an order", () => {
 
 test("loads orders in order", async () => {
   const store: OrderStore = {
-    async findById(id) {
-      return { id, total: 1 };
+    async findByIds(ids) {
+      return ids.map((id) => ({ id, total: 1 }));
     },
   };
   const orders = await loadOrders(store, ["a", "b"]);
   assert.deepEqual(orders.map((o) => o.id), ["a", "b"]);
 });
 
+test("issues one query per request", async () => {
+  let queryCount = 0;
+  const store: OrderStore = {
+    async findByIds(ids) {
+      queryCount += 1;
+      return ids.map((id) => ({ id, total: 1 }));
+    },
+  };
+  const orders = await loadOrders(store, ["a", "b", "c", "a"]);
+  assert.equal(queryCount, 1);
+  assert.deepEqual(orders.map((o) => o.id), ["a", "b", "c", "a"]);
+});
+
+test("restores request order from unordered store results", async () => {
+  const store: OrderStore = {
+    async findByIds(ids) {
+      return ids.map((id) => ({ id, total: 1 })).reverse();
+    },
+  };
+  const orders = await loadOrders(store, ["a", "b", "c"]);
+  assert.deepEqual(orders.map((o) => o.id), ["a", "b", "c"]);
+});
+
+test("throws for the first unresolved identifier in request order", async () => {
+  let queryCount = 0;
+  const store: OrderStore = {
+    async findByIds(ids) {
+      queryCount += 1;
+      return ids.filter((id) => id !== "b").map((id) => ({ id, total: 1 }));
+    },
+  };
+  await assert.rejects(() => loadOrders(store, ["a", "b", "c"]), {
+    message: "order not found: b",
+  });
+  assert.equal(queryCount, 1);
+});
+
+test("issues no query for an empty request", async () => {
+  let queryCount = 0;
+  const store: OrderStore = {
+    async findByIds(ids) {
+      queryCount += 1;
+      return ids.map((id) => ({ id, total: 1 }));
+    },
+  };
+  const orders = await loadOrders(store, []);
+  assert.deepEqual(orders, []);
+  assert.equal(queryCount, 0);
+});
+
 test("resolves a normal file name", () => {
   assert.equal(resolveUserFile("avatar.png"), `${BASE_DIR}/avatar.png`);
 });
