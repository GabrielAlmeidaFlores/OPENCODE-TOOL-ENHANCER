-import { join } from "node:path";
+import { isAbsolute, relative, resolve, sep } from "node:path";
 
 /** Base directory used by {@link resolveUserFile}. */
 export const BASE_DIR = "/srv/user-files";
 
+/** Message used when a file name is not a single, safe path segment. */
+export const ERROR_INVALID_FILE_NAME = "Invalid file name";
+
+const PATH_SEPARATOR_PATTERN = /[\\/]/;
+const PARENT_SEGMENT_PATTERN = /(^|[\\/])\.\.([\\/]|$)/;
+const NULL_BYTE = "\u0000";
+const MAX_DECODE_PASSES = 4;
+
 /**
- * Resolves a user-supplied file name under {@link BASE_DIR}.
+ * Decodes percent-encoded input until it stops changing.
  *
  * @param name - User-supplied file name.
- * @returns The joined path.
- * @remarks Intentionally vulnerable to path traversal to support the security benchmark task.
+ * @returns The fully decoded form, or the last successfully decoded form when an escape sequence is malformed.
+ * @remarks Repeated decoding detects nested encodings such as `%252e%252e`. Malformed escapes are left undecoded so that literal `%` characters in valid names are not rejected.
+ */
+function decodeForValidation(name: string): string {
+  let current = name;
+  for (let pass = 0; pass < MAX_DECODE_PASSES; pass += 1) {
+    let decoded: string;
+    try {
+      decoded = decodeURIComponent(current);
+    } catch {
+      return current;
+    }
+    if (decoded === current) {
+      return current;
+    }
+    current = decoded;
+  }
+  return current;
+}
+
+/**
+ * Resolves a user-supplied file name under {@link BASE_DIR}.
+ *
+ * @param name - User-supplied file name, which must be a single path segment.
+ * @returns The absolute path of the named file inside {@link BASE_DIR}.
+ * @throws Error with message {@link ERROR_INVALID_FILE_NAME} when the name is empty, absolute, contains a path separator or null byte, or resolves outside {@link BASE_DIR}.
  */
 export function resolveUserFile(name: string): string {
-  return join(BASE_DIR, name);
+  const decodedName = decodeForValidation(name);
+
+  if (
+    decodedName.length === 0 ||
+    decodedName === "." ||
+    decodedName === ".." ||
+    decodedName.includes(NULL_BYTE) ||
+    isAbsolute(decodedName) ||
+    PATH_SEPARATOR_PATTERN.test(decodedName) ||
+    PARENT_SEGMENT_PATTERN.test(decodedName)
+  ) {
+    throw new Error(ERROR_INVALID_FILE_NAME);
+  }
+
+  const resolvedPath = resolve(BASE_DIR, name);
+  const pathFromBase = relative(BASE_DIR, resolvedPath);
+
+  if (pathFromBase === ".." || pathFromBase.startsWith(`..${sep}`) || isAbsolute(pathFromBase)) {
+    throw new Error(ERROR_INVALID_FILE_NAME);
+  }
+
+  return resolvedPath;
 }
