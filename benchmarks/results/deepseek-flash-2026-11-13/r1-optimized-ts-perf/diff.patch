 import { lineTotal, orderTotal } from "./pricing.js";
-import { loadOrders, type OrderStore } from "./repository.js";
+import {
+  loadOrders,
+  MESSAGE_ORDER_NOT_FOUND_PREFIX,
+  type Order,
+  type OrderStore,
+} from "./repository.js";
 import { resolveUserFile, BASE_DIR } from "./files.js";
 
+/** Upper bound on store round trips allowed for a single {@link loadOrders} call. */
+const MAX_QUERIES_PER_REQUEST = 1;
+const FIRST_ORDER_ID = "a";
+const SECOND_ORDER_ID = "b";
+const MISSING_ORDER_ID = "missing";
+const ALSO_MISSING_ORDER_ID = "also-missing";
+
+/** Store plus the identifier batches it received, in call order. */
+interface RecordingStore {
+  store: OrderStore;
+  batches: string[][];
+}
+
+/**
+ * Builds an {@link OrderStore} backed by `orders` that records every batch.
+ *
+ * @param orders - Orders the store can resolve.
+ * @returns The recording store and the batches it received.
+ */
+function createRecordingStore(orders: Order[]): RecordingStore {
+  const ordersById = new Map(orders.map((order) => [order.id, order]));
+  const batches: string[][] = [];
+  const store: OrderStore = {
+    async findByIds(ids) {
+      batches.push([...ids]);
+      return ids.flatMap((id) => {
+        const order = ordersById.get(id);
+        return order ? [order] : [];
+      });
+    },
+  };
+  return { store, batches };
+}
+
+/**
+ * Wraps `store` so the test fails when `loadOrders` issues more than
+ * {@link MAX_QUERIES_PER_REQUEST} query.
+ *
+ * @param store - Store to guard.
+ * @returns The guarded store and a function returning the observed query count.
+ */
+function guardQueryCount(store: OrderStore): { store: OrderStore; queryCount: () => number } {
+  let queries = 0;
+  return {
+    store: {
+      async findByIds(ids) {
+        queries += 1;
+        if (queries > MAX_QUERIES_PER_REQUEST) {
+          throw new Error(`query budget exceeded: ${queries} queries for one request`);
+        }
+        return store.findByIds(ids);
+      },
+    },
+    queryCount: () => queries,
+  };
+}
+
