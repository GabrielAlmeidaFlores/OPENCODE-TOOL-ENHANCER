+import { parseCreateUser, type CreateUser } from "./validation.js";
+
+/** HTTP status for a rejected create-user request. */
+export const HTTP_BAD_REQUEST = 400;
+
+/** HTTP status for a created user. */
+export const HTTP_CREATED = 201;
+
+/** Response body returned when a create-user request is rejected. */
+export interface CreateUserErrorBody {
+  errors: string[];
+}
+
+/** Response body returned when a user is created. */
+export interface CreateUserSuccessBody {
+  user: CreateUser;
+}
+
+/** Result of {@link handleCreateUserRequest}. */
+export type CreateUserResponse =
+  | { status: typeof HTTP_CREATED; body: CreateUserSuccessBody }
+  | { status: typeof HTTP_BAD_REQUEST; body: CreateUserErrorBody };
+
+/**
+ * Handles a create-user request.
+ *
+ * @param input - Untrusted request data decoded from the request body.
+ * @returns A 201 response with the normalized user, or a 400 response with validation errors.
+ */
+export function handleCreateUserRequest(input: unknown): CreateUserResponse {
+  const result = parseCreateUser(input);
+  if (!result.ok) {
+    return { status: HTTP_BAD_REQUEST, body: { errors: result.errors } };
+  }
+  return { status: HTTP_CREATED, body: { user: result.value } };
+}
