+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import {
+  createUserEndpoint,
+  ERROR_INVALID_REQUEST,
+  STATUS_BAD_REQUEST,
+  STATUS_CREATED,
+} from "./endpoint.js";
+import {
+  MESSAGE_AGE_INVALID,
+  MESSAGE_BODY_NOT_OBJECT,
+  MESSAGE_EMAIL_INVALID,
+  MESSAGE_NAME_REQUIRED,
+} from "./validation.js";
+
+test("accepts a complete valid body", () => {
+  assert.deepEqual(createUserEndpoint({ email: "a@b.co", name: "Ada", age: 30 }), {
+    status: STATUS_CREATED,
+    body: { user: { email: "a@b.co", name: "Ada", age: 30 } },
+  });
+});
+
+test("accepts a body without the optional age", () => {
+  assert.deepEqual(createUserEndpoint({ email: "a@b.co", name: "Ada" }), {
+    status: STATUS_CREATED,
+    body: { user: { email: "a@b.co", name: "Ada" } },
+  });
+});
+
+test("normalizes surrounding whitespace", () => {
+  assert.deepEqual(createUserEndpoint({ email: "  a@b.co  ", name: "  Ada  " }), {
+    status: STATUS_CREATED,
+    body: { user: { email: "a@b.co", name: "Ada" } },
+  });
+});
+
+test("rejects a body missing email with a 400", () => {
+  const response = createUserEndpoint({ name: "Ada" });
+  assert.equal(response.status, STATUS_BAD_REQUEST);
+  assert.deepEqual(response.body, {
+    error: ERROR_INVALID_REQUEST,
+    errors: [MESSAGE_EMAIL_INVALID],
+  });
+});
+
+test("rejects a body missing name with a 400", () => {
+  const response = createUserEndpoint({ email: "a@b.co" });
+  assert.equal(response.status, STATUS_BAD_REQUEST);
+  assert.deepEqual(response.body, {
+    error: ERROR_INVALID_REQUEST,
+    errors: [MESSAGE_NAME_REQUIRED],
+  });
+});
+
+test("rejects a blank name with a 400", () => {
+  const response = createUserEndpoint({ email: "a@b.co", name: "   " });
+  assert.equal(response.status, STATUS_BAD_REQUEST);
+  assert.deepEqual(response.body, {
+    error: ERROR_INVALID_REQUEST,
+    errors: [MESSAGE_NAME_REQUIRED],
+  });
+});
+
+test("rejects a malformed email with a 400", () => {
+  const response = createUserEndpoint({ email: "not-an-email", name: "Ada" });
+  assert.equal(response.status, STATUS_BAD_REQUEST);
+  assert.deepEqual(response.body, {
+    error: ERROR_INVALID_REQUEST,
+    errors: [MESSAGE_EMAIL_INVALID],
+  });
+});
+
+test("rejects a non-string email with a 400", () => {
+  const response = createUserEndpoint({ email: 42, name: "Ada" });
+  assert.equal(response.status, STATUS_BAD_REQUEST);
+  assert.deepEqual(response.body, {
+    error: ERROR_INVALID_REQUEST,
+    errors: [MESSAGE_EMAIL_INVALID],
+  });
+});
+
+test("reports every invalid field at once", () => {
+  const response = createUserEndpoint({ email: "nope", age: -1 });
+  assert.equal(response.status, STATUS_BAD_REQUEST);
+  assert.deepEqual(response.body, {
+    error: ERROR_INVALID_REQUEST,
+    errors: [MESSAGE_EMAIL_INVALID, MESSAGE_NAME_REQUIRED, MESSAGE_AGE_INVALID],
+  });
+});
+
+test("rejects a negative age with a 400", () => {
+  const response = createUserEndpoint({ email: "a@b.co", name: "Ada", age: -1 });
+  assert.equal(response.status, STATUS_BAD_REQUEST);
+  assert.deepEqual(response.body, {
+    error: ERROR_INVALID_REQUEST,
+    errors: [MESSAGE_AGE_INVALID],
+  });
+});
+
+test("rejects a fractional age with a 400", () => {
+  const response = createUserEndpoint({ email: "a@b.co", name: "Ada", age: 30.5 });
+  assert.equal(response.status, STATUS_BAD_REQUEST);
+  assert.deepEqual(response.body, {
+    error: ERROR_INVALID_REQUEST,
+    errors: [MESSAGE_AGE_INVALID],
+  });
+});
+
+test("rejects a stringified age instead of coercing it", () => {
+  const response = createUserEndpoint({ email: "a@b.co", name: "Ada", age: "30" });
+  assert.equal(response.status, STATUS_BAD_REQUEST);
+  assert.deepEqual(response.body, {
+    error: ERROR_INVALID_REQUEST,
+    errors: [MESSAGE_AGE_INVALID],
+  });
+});
+
+test("rejects a non-object body with a 400", () => {
+  for (const body of [undefined, null, "", "{}", 7, true, ["a@b.co"]]) {
+    const response = createUserEndpoint(body);
+    assert.equal(response.status, STATUS_BAD_REQUEST);
+    assert.deepEqual(response.body, {
+      error: ERROR_INVALID_REQUEST,
+      errors: [MESSAGE_BODY_NOT_OBJECT],
+    });
+  }
+});
