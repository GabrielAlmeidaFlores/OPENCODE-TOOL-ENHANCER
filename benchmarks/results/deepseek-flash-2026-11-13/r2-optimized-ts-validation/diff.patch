+import { parseCreateUser, type CreateUser } from "./validation.js";
+
+/** Status returned when a create-user request is accepted. */
+export const STATUS_CREATED = 201;
+
+/** Status returned when a create-user request is rejected. */
+export const STATUS_BAD_REQUEST = 400;
+
+/** Machine-readable error code attached to a rejected create-user request. */
+export const ERROR_INVALID_REQUEST = "invalid_request";
+
+/** Body returned with {@link STATUS_CREATED}. */
+export interface CreateUserResponseBody {
+  user: CreateUser;
+}
+
+/** Body returned with {@link STATUS_BAD_REQUEST}. */
+export interface CreateUserErrorBody {
+  error: string;
+  errors: string[];
+}
+
+/** Response produced by {@link createUserEndpoint}. */
+export type CreateUserResponse =
+  | { status: typeof STATUS_CREATED; body: CreateUserResponseBody }
+  | { status: typeof STATUS_BAD_REQUEST; body: CreateUserErrorBody };
+
+/**
+ * Handles `POST /users` for the example API.
+ *
+ * @param body - Untrusted request body, already decoded from JSON when the transport parsed one.
+ * @returns A 201 response with the normalized user, or a 400 response listing every validation error.
+ */
+export function createUserEndpoint(body: unknown): CreateUserResponse {
+  const parsed = parseCreateUser(body);
+  if (!parsed.ok) {
+    return {
+      status: STATUS_BAD_REQUEST,
+      body: { error: ERROR_INVALID_REQUEST, errors: parsed.errors },
+    };
+  }
+  return { status: STATUS_CREATED, body: { user: parsed.value } };
+}
