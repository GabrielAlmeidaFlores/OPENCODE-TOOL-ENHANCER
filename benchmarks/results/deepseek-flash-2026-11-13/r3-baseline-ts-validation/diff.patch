@@ -0,0 +1,36 @@
+import { parseCreateUser, type CreateUser } from "./validation.js";
+
+/** Status returned by {@link handleCreateUser} when validation fails. */
+export const HTTP_STATUS_BAD_REQUEST = 400;
+
+/** Status returned by {@link handleCreateUser} when a user is created. */
+export const HTTP_STATUS_CREATED = 201;
+
+/** Successful response from {@link handleCreateUser}. */
+export interface CreateUserCreatedResponse {
+  status: typeof HTTP_STATUS_CREATED;
+  body: { user: CreateUser };
+}
+
+/** Validation failure response from {@link handleCreateUser}. */
+export interface CreateUserBadRequestResponse {
+  status: typeof HTTP_STATUS_BAD_REQUEST;
+  body: { errors: string[] };
+}
+
+/** Response returned by {@link handleCreateUser}. */
+export type CreateUserResponse = CreateUserCreatedResponse | CreateUserBadRequestResponse;
+
+/**
+ * Handles a create-user request at the API boundary.
+ *
+ * @param payload - Untrusted request body.
+ * @returns A 201 response with the validated user, or a 400 response with validation errors.
+ */
+export function handleCreateUser(payload: unknown): CreateUserResponse {
+  const result = parseCreateUser(payload);
+  if (!result.ok) {
+    return { status: HTTP_STATUS_BAD_REQUEST, body: { errors: result.errors } };
+  }
+  return { status: HTTP_STATUS_CREATED, body: { user: result.user } };
+}
