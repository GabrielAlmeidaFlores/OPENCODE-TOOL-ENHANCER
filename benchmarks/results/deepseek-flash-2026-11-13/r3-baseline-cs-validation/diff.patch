+/// <summary>Handles the create-user endpoint and reports invalid input as a problem response.</summary>
+public static class CreateUserEndpoint
+{
+    /// <summary>Problem title used when the request body is absent.</summary>
+    public const string MissingBodyTitle = "Missing request body";
+
+    /// <summary>Problem detail used when the request body is absent.</summary>
+    public const string MissingBodyDetail = "A JSON create-user request body is required.";
+
+    /// <summary>Problem title used when the request body is not a valid create-user payload.</summary>
+    public const string MalformedBodyTitle = "Malformed request body";
+
+    /// <summary>Problem detail used when the request body is not a valid create-user payload.</summary>
+    public const string MalformedBodyDetail = "The request body must be a JSON object with email, name, and optional age fields.";
+
+    /// <summary>Problem title used when the payload fails validation.</summary>
+    public const string InvalidRequestTitle = "Invalid create-user request";
+
+    /// <summary>JSON contract used to read the request body.</summary>
+    public static readonly JsonSerializerOptions BodyJsonOptions = new(JsonSerializerDefaults.Web);
+
+    /// <summary>Handles a create-user request body.</summary>
+    /// <param name="body">Raw JSON body received by the endpoint.</param>
+    /// <returns>200 with the accepted payload; 400 problem details for missing, malformed, or invalid input.</returns>
+    public static IResult Handle(string? body)
+    {
+        if (string.IsNullOrWhiteSpace(body))
+        {
+            return Results.Problem(
+                title: MissingBodyTitle,
+                detail: MissingBodyDetail,
+                statusCode: StatusCodes.Status400BadRequest);
+        }
+
+        CreateUserRequest? request;
+        try
+        {
+            request = JsonSerializer.Deserialize<CreateUserRequest>(body, BodyJsonOptions);
+        }
+        catch (JsonException)
+        {
+            return Results.Problem(
+                title: MalformedBodyTitle,
+                detail: MalformedBodyDetail,
+                statusCode: StatusCodes.Status400BadRequest);
+        }
+
+        if (request is null)
+        {
+            return Results.Problem(
+                title: MalformedBodyTitle,
+                detail: MalformedBodyDetail,
+                statusCode: StatusCodes.Status400BadRequest);
+        }
+
+        var errors = Validator.ValidateFields(request);
+        if (errors.Count > 0)
+        {
+            return Results.ValidationProblem(
+                errors.ToDictionary(pair => pair.Key, pair => pair.Value),
+                title: InvalidRequestTitle,
+                statusCode: StatusCodes.Status400BadRequest);
+        }
+
+        return Results.Ok(new CreateUserResponse(request.Email!, request.Name!, request.Age));
+    }
