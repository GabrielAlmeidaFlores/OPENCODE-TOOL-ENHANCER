+using System.Text.Json;
+
+namespace Example;
+
+/// <summary>Problem document returned when a request cannot be processed.</summary>
+/// <param name="Status">HTTP status code describing the failure class.</param>
+/// <param name="Title">Short, stable, user-facing summary of the failure.</param>
+/// <param name="Errors">User-facing messages explaining every rejection reason; empty when the body itself was unusable.</param>
+/// <remarks>Serializes to an RFC 9457 problem document, with <paramref name="Errors"/> exposed as the <c>errors</c> extension member.</remarks>
+public sealed record ProblemResponse(int Status, string Title, IReadOnlyList<string> Errors)
+{
+    /// <summary>Status code returned for every rejected create-user request.</summary>
+    public const int RejectedStatus = 400;
+
+    /// <summary>Title used when the caller sent no request body.</summary>
+    public const string MissingBodyTitle = "Missing request body";
+
+    /// <summary>Title used when the body is not a JSON create-user request.</summary>
+    public const string MalformedBodyTitle = "Malformed request body";
+
+    /// <summary>Title used when the body parsed but its fields failed validation.</summary>
+    public const string InvalidFieldsTitle = "Request validation failed";
+}
+
+/// <summary>Outcome of handling a create-user request.</summary>
+public abstract record CreateUserOutcome
+{
+    /// <summary>The request parsed and passed validation.</summary>
+    /// <param name="User">Validated request data ready for persistence.</param>
+    public sealed record Accepted(CreateUserRequest User) : CreateUserOutcome;
+
+    /// <summary>The request was rejected and must not be persisted.</summary>
+    /// <param name="Problem">Problem document to return to the caller.</param>
+    public sealed record Rejected(ProblemResponse Problem) : CreateUserOutcome;
+}
+
+/// <summary>Create-user endpoint: parses the request body, then validates the parsed request.</summary>
+public static class CreateUserEndpoint
+{
+    /// <summary>Deserialization settings for request bodies.</summary>
+    private static readonly JsonSerializerOptions RequestJsonOptions = new()
+    {
+        PropertyNameCaseInsensitive = true,
+    };
+
+    /// <summary>Handles a create-user request body.</summary>
+    /// <param name="body">Raw JSON request body, or <see langword="null"/> when the caller sent no payload.</param>
+    /// <returns>Accepted request data for a status-201 response, or the problem document to return instead.</returns>
+    public static CreateUserOutcome Handle(string? body)
+    {
+        if (string.IsNullOrWhiteSpace(body))
+        {
+            return Reject(ProblemResponse.MissingBodyTitle, Array.Empty<string>());
+        }
+
+        CreateUserRequest? request;
+        try
+        {
+            request = JsonSerializer.Deserialize<CreateUserRequest>(body, RequestJsonOptions);
+        }
+        catch (JsonException)
+        {
+            return Reject(ProblemResponse.MalformedBodyTitle, Array.Empty<string>());
+        }
+
+        if (request is null)
+        {
+            return Reject(ProblemResponse.MalformedBodyTitle, Array.Empty<string>());
+        }
+
+        IReadOnlyList<string> errors = Validator.Validate(request);
+
+        return errors.Count == 0
+            ? new CreateUserOutcome.Accepted(request)
+            : Reject(ProblemResponse.InvalidFieldsTitle, errors);
+    }
+
+    /// <summary>Builds a rejected outcome carrying a problem document.</summary>
+    /// <param name="title">Problem title from <see cref="ProblemResponse"/>.</param>
+    /// <param name="errors">User-facing rejection messages.</param>
+    /// <returns>The rejected outcome.</returns>
+    private static CreateUserOutcome.Rejected Reject(string title, IReadOnlyList<string> errors)
+        => new(new ProblemResponse(ProblemResponse.RejectedStatus, title, errors));
+}
