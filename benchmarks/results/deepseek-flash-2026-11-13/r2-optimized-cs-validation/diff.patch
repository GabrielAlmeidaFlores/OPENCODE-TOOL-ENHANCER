+using System.Text.Json;
+using Example;
+using Xunit;
+
+namespace Example.Tests;
+
+/// <summary>Tests for <see cref="CreateUserEndpoint"/> payload handling.</summary>
+public class CreateUserEndpointTests
+{
+    /// <summary>Verifies that a well-formed payload is accepted and deserialized case-insensitively.</summary>
+    [Fact]
+    public void AcceptsValidPayload()
+    {
+        var outcome = CreateUserEndpoint.Handle("""{"email":"a@b.co","name":"Ada","age":30}""");
+
+        var accepted = Assert.IsType<CreateUserOutcome.Accepted>(outcome);
+        Assert.Equal("a@b.co", accepted.User.Email);
+        Assert.Equal("Ada", accepted.User.Name);
+        Assert.Equal(30, accepted.User.Age);
+    }
+
+    /// <summary>Verifies that an optional field may be omitted from a well-formed payload.</summary>
+    [Fact]
+    public void AcceptsPayloadWithoutOptionalAge()
+    {
+        var outcome = CreateUserEndpoint.Handle("""{"email":"a@b.co","name":"Ada"}""");
+
+        var accepted = Assert.IsType<CreateUserOutcome.Accepted>(outcome);
+        Assert.Null(accepted.User.Age);
+    }
+
+    /// <summary>Verifies that an absent body produces a 400 problem response.</summary>
+    [Fact]
+    public void RejectsMissingPayload()
+    {
+        var problem = RejectedProblem(null);
+
+        Assert.Equal(ProblemResponse.RejectedStatus, problem.Status);
+        Assert.Equal(ProblemResponse.MissingBodyTitle, problem.Title);
+        Assert.Empty(problem.Errors);
+    }
+
+    /// <summary>Verifies that a blank body produces a 400 problem response.</summary>
+    [Fact]
+    public void RejectsBlankPayload()
+    {
+        var problem = RejectedProblem("   \n\t ");
+
+        Assert.Equal(ProblemResponse.MissingBodyTitle, problem.Title);
+    }
+
+    /// <summary>Verifies that syntactically invalid JSON produces a 400 problem response.</summary>
+    [Fact]
+    public void RejectsTruncatedJson()
+    {
+        var problem = RejectedProblem("""{"email":"a@b.co","name":"Ada","age":30""");
+
+        Assert.Equal(ProblemResponse.RejectedStatus, problem.Status);
+        Assert.Equal(ProblemResponse.MalformedBodyTitle, problem.Title);
+    }
+
+    /// <summary>Verifies that JSON of the wrong type produces a 400 problem response.</summary>
+    [Fact]
+    public void RejectsJsonThatIsNotAnObject()
+    {
+        var problem = RejectedProblem("""["a@b.co","Ada"]""");
+
+        Assert.Equal(ProblemResponse.MalformedBodyTitle, problem.Title);
+    }
+
+    /// <summary>Verifies that a null JSON payload produces a 400 problem response.</summary>
+    [Fact]
+    public void RejectsJsonNull()
+    {
+        var problem = RejectedProblem("null");
+
+        Assert.Equal(ProblemResponse.MalformedBodyTitle, problem.Title);
+    }
+
+    /// <summary>Verifies that a field of the wrong type produces a 400 problem response.</summary>
+    [Fact]
+    public void RejectsPayloadWithWrongFieldType()
+    {
+        var problem = RejectedProblem("""{"email":"a@b.co","name":"Ada","age":"thirty"}""");
+
+        Assert.Equal(ProblemResponse.MalformedBodyTitle, problem.Title);
+    }
+
+    /// <summary>Verifies that a parsed payload failing validation produces a 400 problem response listing every failure.</summary>
+    [Fact]
+    public void RejectsInvalidFields()
+    {
+        var problem = RejectedProblem("""{"email":"not-an-address","name":"","age":-1}""");
+
+        Assert.Equal(ProblemResponse.RejectedStatus, problem.Status);
+        Assert.Equal(ProblemResponse.InvalidFieldsTitle, problem.Title);
+        Assert.Equal(
+            new[]
+            {
+                Validator.InvalidEmailMessage,
+                Validator.MissingNameMessage,
+                Validator.NegativeAgeMessage,
+            },
+            problem.Errors);
+    }
+
+    /// <summary>Verifies that the problem document serializes with the RFC 9457 field names.</summary>
+    [Fact]
+    public void SerializesProblemDocument()
+    {
+        var problem = RejectedProblem("""{"email":"not-an-address","name":"Ada"}""");
+
+        var json = JsonSerializer.Serialize(problem, new JsonSerializerOptions(JsonSerializerDefaults.Web));
+        using var document = JsonDocument.Parse(json);
+        var root = document.RootElement;
+
+        Assert.Equal(ProblemResponse.RejectedStatus, root.GetProperty("status").GetInt32());
+        Assert.Equal(ProblemResponse.InvalidFieldsTitle, root.GetProperty("title").GetString());
+        Assert.Equal(Validator.InvalidEmailMessage, root.GetProperty("errors")[0].GetString());
+    }
+
+    /// <summary>Handles a payload and returns the problem document the endpoint would respond with.</summary>
+    /// <param name="body">Raw request body under test.</param>
+    /// <returns>The problem document carried by the rejected outcome.</returns>
+    private static ProblemResponse RejectedProblem(string? body)
+    {
+        var rejected = Assert.IsType<CreateUserOutcome.Rejected>(CreateUserEndpoint.Handle(body));
+        return rejected.Problem;
+    }
+}
