index 15cd72f..d1e883c 100644
--- a/examples/typescript/src/app.test.ts
+++ b/examples/typescript/src/app.test.ts
@@ -36,14 +36,57 @@ test("totals an order", () => {
 
 test("loads orders in order", async () => {
   const store: OrderStore = {
-    async findById(id) {
-      return { id, total: 1 };
+    async findByIds(ids) {
+      return ids.map((id) => ({ id, total: 1 }));
     },
   };
   const orders = await loadOrders(store, ["a", "b"]);
   assert.deepEqual(orders.map((o) => o.id), ["a", "b"]);
 });
 
+test("loads orders with a single query per request", async () => {
+  const queries: string[][] = [];
+  const store: OrderStore = {
+    async findByIds(ids) {
+      queries.push([...ids]);
+      return [...ids].reverse().map((id) => ({ id, total: 1 }));
+    },
+  };
+
+  const orders = await loadOrders(store, ["a", "b", "c", "d"]);
+
+  assert.equal(queries.length, 1);
+  assert.deepEqual(queries[0], ["a", "b", "c", "d"]);
+  assert.deepEqual(orders.map((o) => o.id), ["a", "b", "c", "d"]);
+});
+
+test("loads repeated orders in requested order", async () => {
+  const store: OrderStore = {
+    async findByIds(ids) {
+      return [...ids].reverse().map((id) => ({ id, total: 1 }));
+    },
+  };
+
+  const orders = await loadOrders(store, ["b", "a", "b"]);
+
+  assert.deepEqual(orders.map((o) => o.id), ["b", "a", "b"]);
+});
+
+test("reports the first missing order after a single batched query", async () => {
+  let queryCount = 0;
+  const store: OrderStore = {
+    async findByIds(ids) {
+      queryCount += 1;
+      return ids.filter((id) => id !== "b").map((id) => ({ id, total: 1 }));
+    },
+  };
+
+  await assert.rejects(loadOrders(store, ["a", "b", "c"]), {
+    message: "order not found: b",
+  });
+  assert.equal(queryCount, 1);
+});
+
 test("resolves a normal file name", () => {
   assert.equal(resolveUserFile("avatar.png"), `${BASE_DIR}/avatar.png`);
 });
