@@ -11,28 +11,92 @@ export interface ValidationResult {
   errors: string[];
 }
 
+/** Response produced by {@link handleCreateUserRequest}. */
+export interface CreateUserResponse {
+  status: number;
+  body: ValidationResult;
+}
+
+/** HTTP status codes used by the create-user endpoint. */
+export const CreateUserStatus = {
+  OK: 200,
+  BAD_REQUEST: 400,
+} as const;
+
+/** Stable, user-facing validation messages. */
+export const ValidationMessage = {
+  INVALID_BODY: "request body must be a JSON object",
+  INVALID_EMAIL: "email must be a valid address",
+  MISSING_NAME: "name is required",
+  INVALID_AGE: "age must be a non-negative integer",
+} as const;
+
+const EMAIL_SEPARATOR = "@";
+const WHITESPACE = /\s/u;
+
+/**
+ * Checks that an email address has one separator with non-empty sides.
+ *
+ * @param value - Candidate email address.
+ * @returns Whether the value has a valid email shape.
+ */
+function hasValidEmailShape(value: string): boolean {
+  const separatorIndex = value.indexOf(EMAIL_SEPARATOR);
+  const hasSingleSeparator = separatorIndex === value.lastIndexOf(EMAIL_SEPARATOR);
+  const hasLocalPart = separatorIndex > 0;
+  const hasDomainPart = separatorIndex < value.length - 1;
+
+  return (
+    hasSingleSeparator &&
+    hasLocalPart &&
+    hasDomainPart &&
+    !WHITESPACE.test(value)
+  );
+}
+
 /**
  * Validates a create-user request at the API boundary.
  *
- * @param input - Untrusted request data.
+ * @param input - Untrusted request data; any JSON value is accepted.
  * @returns Whether the input is valid and the list of validation errors.
