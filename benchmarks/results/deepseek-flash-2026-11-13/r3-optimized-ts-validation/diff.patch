-export function validateCreateUser(input: CreateUserInput): ValidationResult {
+export function validateCreateUser(input: unknown): ValidationResult {
   const errors: string[] = [];
 
-  if (typeof input.email !== "string" || !input.email.includes("@")) {
-    errors.push("email must be a valid address");
+  if (typeof input !== "object" || input === null || Array.isArray(input)) {
+    return { ok: false, errors: [ValidationMessage.INVALID_BODY] };
   }
 
-  if (typeof input.name !== "string" || input.name.trim().length === 0) {
-    errors.push("name is required");
+  const { email, name, age } = input as CreateUserInput;
+
+  if (typeof email !== "string" || !hasValidEmailShape(email)) {
+    errors.push(ValidationMessage.INVALID_EMAIL);
   }
 
-  if (input.age !== undefined) {
-    if (typeof input.age !== "number" || !Number.isInteger(input.age) || input.age < 0) {
-      errors.push("age must be a non-negative integer");
+  if (typeof name !== "string" || name.trim().length === 0) {
+    errors.push(ValidationMessage.MISSING_NAME);
+  }
+
+  if (age !== undefined) {
+    if (typeof age !== "number" || !Number.isInteger(age) || age < 0) {
+      errors.push(ValidationMessage.INVALID_AGE);
     }
   }
 
   return { ok: errors.length === 0, errors };
 }
+
+/**
+ * Handles a create-user request and maps the validation outcome to a status.
+ *
+ * @param input - Untrusted request data; any JSON value is accepted.
+ * @returns HTTP status 200 for valid input, 400 for invalid input, plus the body.
+ */
+export function handleCreateUserRequest(input: unknown): CreateUserResponse {
+  const result = validateCreateUser(input);
+
+  return {
+    status: result.ok ? CreateUserStatus.OK : CreateUserStatus.BAD_REQUEST,
+    body: result,
+  };
+}
