-import { join } from "node:path";
+import { isAbsolute, join, relative, sep } from "node:path";
 
 /** Base directory used by {@link resolveUserFile}. */
 export const BASE_DIR = "/srv/user-files";
 
+/** Message carried by {@link UnsafeFileNameError}. */
+export const MESSAGE_UNSAFE_FILE_NAME = "file name must resolve inside the base directory";
+
+/**
+ * Bound on percent-decoding passes applied before validation.
+ *
+ * @remarks Upstream proxies may decode a request path more than once, so the
+ * decoded forms are validated too, stopping at the first stable or malformed form.
+ */
+const MAX_PERCENT_DECODE_PASSES = 4;
+
+/** Character that truncates a path at the file-system boundary. */
+const NULL_BYTE = "\u0000";
+
+/** Segment that climbs out of a directory when normalized. */
+const PARENT_SEGMENT = "..";
+
+/** Thrown by {@link resolveUserFile} when a name would escape {@link BASE_DIR}. */
+export class UnsafeFileNameError extends Error {
+  /** Builds the error with the message documented by {@link MESSAGE_UNSAFE_FILE_NAME}. */
+  constructor() {
+    super(MESSAGE_UNSAFE_FILE_NAME);
+    this.name = UnsafeFileNameError.name;
+  }
+}
+
+/**
+ * Yields a name together with each percent-decoded form reachable by repeated decoding.
+ *
+ * @param name - Raw user-supplied name.
+ * @returns The raw name first, then each successfully decoded variant.
+ * @remarks Decoding stops at the first malformed escape sequence, because such a
+ * string cannot be rewritten into a separator by a decoder that follows the URL standard.
+ */
+function* percentDecodedVariants(name: string): Generator<string> {
+  yield name;
+  let current = name;
+  for (let pass = 0; pass < MAX_PERCENT_DECODE_PASSES; pass += 1) {
+    let decoded: string;
+    try {
+      decoded = decodeURIComponent(current);
+    } catch {
+      return;
+    }
+    if (decoded === current) {
+      return;
+    }
+    yield decoded;
+    current = decoded;
+  }
+}
+
+/**
+ * Reports whether a name normalizes to a strict descendant of {@link BASE_DIR}.
+ *
+ * @param name - Candidate name, already percent-decoded when it came from a URL.
+ * @returns `true` when the joined path stays inside {@link BASE_DIR}.
+ * @remarks The check is lexical: the file system is never touched and symbolic
+ * links are not resolved.
+ */
+function isContainedName(name: string): boolean {
+  if (name.length === 0 || name.includes(NULL_BYTE) || isAbsolute(name)) {
+    return false;
+  }
+
+  const relativePath = relative(BASE_DIR, join(BASE_DIR, name));
+
+  return (
+    relativePath !== "" &&
+    relativePath !== PARENT_SEGMENT &&
+    !relativePath.startsWith(`${PARENT_SEGMENT}${sep}`) &&
+    !isAbsolute(relativePath)
+  );
+}
+
 /**
  * Resolves a user-supplied file name under {@link BASE_DIR}.
  *
- * @param name - User-supplied file name.
- * @returns The joined path.
- * @remarks Intentionally vulnerable to path traversal to support the security benchmark task.
+ * @param name - User-supplied file name, percent-encoded or not.
+ * @returns The path of the requested file inside {@link BASE_DIR}.
+ * @throws {UnsafeFileNameError} When the name is empty, absolute, contains a NUL
+ * byte, or normalizes outside {@link BASE_DIR} in its raw or percent-decoded form.
  */
 export function resolveUserFile(name: string): string {
+  for (const variant of percentDecodedVariants(name)) {
+    if (!isContainedName(variant)) {
+      throw new UnsafeFileNameError();
+    }
+  }
+
   return join(BASE_DIR, name);
 }
