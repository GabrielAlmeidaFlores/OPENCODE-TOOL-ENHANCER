+using System.Text.Json;
+
+namespace Example;
+
+/// <summary>Problem-document identifiers and text returned by <see cref="CreateUserEndpoint"/>.</summary>
+public static class ProblemMessages
+{
+    /// <summary>Problem type for a request without a usable body.</summary>
+    public const string MissingBodyType = "https://example.invalid/problems/missing-body";
+
+    /// <summary>Problem type for a body that cannot be read as a create-user payload.</summary>
+    public const string MalformedBodyType = "https://example.invalid/problems/malformed-body";
+
+    /// <summary>Problem type for a readable payload that fails field validation.</summary>
+    public const string ValidationFailedType = "https://example.invalid/problems/validation-failed";
+
+    /// <summary>Title for a request without a usable body.</summary>
+    public const string MissingBodyTitle = "Request body is required";
+
+    /// <summary>Title for a body that cannot be read as a create-user payload.</summary>
+    public const string MalformedBodyTitle = "Malformed request body";
+
+    /// <summary>Title for a readable payload that fails field validation.</summary>
+    public const string ValidationFailedTitle = "Request validation failed";
+
+    /// <summary>Detail for a request without a usable body.</summary>
+    public const string MissingBodyDetail = "Send a JSON object with email, name, and optional age fields.";
+
+    /// <summary>Detail for a body that cannot be read as a create-user payload.</summary>
+    public const string MalformedBodyDetail = "The request body must be a JSON object whose fields match the create-user payload.";
+
+    /// <summary>Detail for a readable payload that fails field validation.</summary>
+    public const string ValidationFailedDetail = "One or more fields are invalid; inspect the errors collection.";
+}
+
+/// <summary>Problem details returned for rejected requests, shaped after RFC 9457.</summary>
+/// <param name="Type">Stable problem type identifier.</param>
+/// <param name="Title">Short human-readable summary.</param>
+/// <param name="Status">HTTP status code.</param>
+/// <param name="Detail">Human-readable explanation of this occurrence.</param>
+/// <param name="Errors">Validation messages keyed by payload field; empty when the failure is not field-specific.</param>
+public sealed record ProblemResponse(
+    string Type,
+    string Title,
+    int Status,
+    string Detail,
+    IReadOnlyDictionary<string, IReadOnlyList<string>> Errors)
+{
+    /// <summary>Status code returned for every rejected create-user request.</summary>
+    public const int BadRequestStatus = 400;
+}
+
+/// <summary>Outcome of a create-user request.</summary>
+/// <param name="Request">Accepted request; null when the request was rejected.</param>
+/// <param name="Problem">Rejection details; null when the request was accepted.</param>
+public sealed record EndpointResult(CreateUserRequest? Request, ProblemResponse? Problem)
+{
+    /// <summary>True when the request passed parsing and validation.</summary>
+    public bool IsSuccess => Problem is null;
+
+    /// <summary>Creates an accepted result.</summary>
+    /// <param name="request">Request that passed validation.</param>
+    /// <returns>A successful result.</returns>
+    public static EndpointResult Succeeded(CreateUserRequest request) => new(request, null);
+
+    /// <summary>Creates a rejected result.</summary>
+    /// <param name="problem">Problem document describing the rejection.</param>
+    /// <returns>A failed result.</returns>
+    public static EndpointResult Rejected(ProblemResponse problem) => new(null, problem);
+}
+
+/// <summary>Handles create-user requests for the example endpoint.</summary>
+public static class CreateUserEndpoint
+{
+    private static readonly JsonSerializerOptions RequestSerializerOptions = new()
+    {
+        PropertyNameCaseInsensitive = true,
+    };
+
+    private static readonly IReadOnlyDictionary<string, IReadOnlyList<string>> EmptyErrors =
+        new Dictionary<string, IReadOnlyList<string>>(StringComparer.Ordinal);
+
+    /// <summary>Parses and validates a raw create-user payload.</summary>
+    /// <param name="jsonBody">Raw request body, or null when the caller sent none.</param>
+    /// <returns>The accepted request, or a problem response for missing, malformed, or invalid input.</returns>
+    public static EndpointResult Handle(string? jsonBody)
+    {
+        if (string.IsNullOrWhiteSpace(jsonBody))
+        {
+            return EndpointResult.Rejected(Problem(
+                ProblemMessages.MissingBodyType,
+                ProblemMessages.MissingBodyTitle,
+                ProblemMessages.MissingBodyDetail,
+                EmptyErrors));
+        }
+
+        CreateUserRequest? request;
+        try
+        {
+            request = JsonSerializer.Deserialize<CreateUserRequest>(jsonBody, RequestSerializerOptions);
+        }
+        catch (JsonException)
+        {
+            return EndpointResult.Rejected(Problem(
+                ProblemMessages.MalformedBodyType,
+                ProblemMessages.MalformedBodyTitle,
+                ProblemMessages.MalformedBodyDetail,
+                EmptyErrors));
+        }
+
+        if (request is null)
+        {
+            return EndpointResult.Rejected(Problem(
+                ProblemMessages.MissingBodyType,
+                ProblemMessages.MissingBodyTitle,
+                ProblemMessages.MissingBodyDetail,
+                EmptyErrors));
+        }
+
+        var errors = Validator.Validate(request);
+        if (errors.Count > 0)
+        {
+            return EndpointResult.Rejected(Problem(
+                ProblemMessages.ValidationFailedType,
+                ProblemMessages.ValidationFailedTitle,
+                ProblemMessages.ValidationFailedDetail,
+                errors));
+        }
+
+        return EndpointResult.Succeeded(request);
+    }
+
+    private static ProblemResponse Problem(
+        string type,
+        string title,
+        string detail,
+        IReadOnlyDictionary<string, IReadOnlyList<string>> errors)
+        => new(type, title, ProblemResponse.BadRequestStatus, detail, errors);
+}
