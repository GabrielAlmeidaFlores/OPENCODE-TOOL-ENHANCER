+using Example;
+using Xunit;
+
+namespace Example.Tests;
+
+/// <summary>Tests for <see cref="CreateUserEndpoint"/> payload handling.</summary>
+public class CreateUserEndpointTests
+{
+    private const string ValidPayload =
+        """{"email":"a@b.co","name":"Ada","age":30}""";
+
+    private const string ValidEmail = "a@b.co";
+    private const string ValidName = "Ada";
+    private const int ValidAge = 30;
+
+    /// <summary>Verifies that a complete payload is accepted and parsed.</summary>
+    [Fact]
+    public void AcceptsValidPayload()
+    {
+        var result = CreateUserEndpoint.Handle(ValidPayload);
+
+        Assert.True(result.IsSuccess);
+        var request = Assert.IsType<CreateUserRequest>(result.Request);
+        Assert.Equal(ValidEmail, request.Email);
+        Assert.Equal(ValidName, request.Name);
+        Assert.Equal(ValidAge, request.Age);
+    }
+
+    /// <summary>Verifies that property names are matched without regard to case.</summary>
+    [Fact]
+    public void AcceptsPayloadWithDifferentPropertyCasing()
+    {
+        var result = CreateUserEndpoint.Handle("""{"Email":"a@b.co","NAME":"Ada","Age":30}""");
+
+        Assert.True(result.IsSuccess);
+    }
+
+    /// <summary>Verifies that the optional age field may be omitted.</summary>
+    [Fact]
+    public void AcceptsPayloadWithoutAge()
+    {
+        var result = CreateUserEndpoint.Handle("""{"email":"a@b.co","name":"Ada"}""");
+
+        Assert.True(result.IsSuccess);
+        Assert.Null(Assert.IsType<CreateUserRequest>(result.Request).Age);
+    }
+
+    /// <summary>Verifies that a missing body yields a bad-request problem.</summary>
+    /// <param name="payload">Body that carries no usable payload.</param>
+    [Theory]
+    [InlineData(null)]
+    [InlineData("")]
+    [InlineData("   ")]
+    [InlineData("null")]
+    public void RejectsMissingPayload(string? payload)
+    {
+        var result = CreateUserEndpoint.Handle(payload);
+
+        Assert.False(result.IsSuccess);
+        Assert.Null(result.Request);
+        var problem = Assert.IsType<ProblemResponse>(result.Problem);
+        Assert.Equal(ProblemMessages.MissingBodyType, problem.Type);
+        Assert.Equal(ProblemMessages.MissingBodyTitle, problem.Title);
+        Assert.Equal(ProblemMessages.MissingBodyDetail, problem.Detail);
+        Assert.Equal(ProblemResponse.BadRequestStatus, problem.Status);
+        Assert.Empty(problem.Errors);
+    }
+
+    /// <summary>Verifies that a body that cannot be read as a create-user payload yields a bad-request problem.</summary>
+    /// <param name="payload">Body that is not valid JSON for this endpoint.</param>
+    [Theory]
+    [InlineData("{\"email\":")]
+    [InlineData("not json at all")]
+    [InlineData("[{\"email\":\"a@b.co\"}]")]
+    [InlineData("{\"email\":\"a@b.co\",\"name\":\"Ada\",\"age\":\"thirty\"}")]
+    public void RejectsMalformedPayload(string payload)
+    {
+        var result = CreateUserEndpoint.Handle(payload);
+
+        Assert.False(result.IsSuccess);
+        Assert.Null(result.Request);
+        var problem = Assert.IsType<ProblemResponse>(result.Problem);
+        Assert.Equal(ProblemMessages.MalformedBodyType, problem.Type);
+        Assert.Equal(ProblemMessages.MalformedBodyTitle, problem.Title);
+        Assert.Equal(ProblemMessages.MalformedBodyDetail, problem.Detail);
+        Assert.Equal(ProblemResponse.BadRequestStatus, problem.Status);
+        Assert.Empty(problem.Errors);
+    }
+
+    /// <summary>Verifies that a readable payload with invalid fields yields a problem carrying field errors.</summary>
+    [Fact]
+    public void RejectsInvalidFieldsWithFieldErrors()
+    {
+        var result = CreateUserEndpoint.Handle("""{"name":"Ada","age":-1}""");
+
+        Assert.False(result.IsSuccess);
+        var problem = Assert.IsType<ProblemResponse>(result.Problem);
+        Assert.Equal(ProblemMessages.ValidationFailedType, problem.Type);
+        Assert.Equal(ProblemMessages.ValidationFailedTitle, problem.Title);
+        Assert.Equal(ProblemResponse.BadRequestStatus, problem.Status);
+        Assert.Equal([UserMessages.EmailInvalid], problem.Errors[UserFields.Email]);
+        Assert.Equal([UserMessages.AgeNonNegative], problem.Errors[UserFields.Age]);
+        Assert.False(problem.Errors.ContainsKey(UserFields.Name));
+    }
+}
