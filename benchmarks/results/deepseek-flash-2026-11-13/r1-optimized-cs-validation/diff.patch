+public sealed record CreateUserResponse(string Email, string Name, int? Age);
+
+/// <summary>Outcome of handling a create-user request: either a created user or a problem.</summary>
+/// <param name="StatusCode">HTTP status code the endpoint would return.</param>
+/// <param name="User">Created user when <paramref name="StatusCode"/> is <see cref="HttpStatus.Created"/>.</param>
+/// <param name="Problem">Problem details when the request was rejected.</param>
+public sealed record EndpointResponse(int StatusCode, CreateUserResponse? User, ProblemResponse? Problem)
+{
+    /// <summary>Records an accepted request.</summary>
+    /// <param name="user">Validated user data.</param>
+    /// <returns>A 201 response carrying the created user and no problem.</returns>
+    public static EndpointResponse Created(CreateUserResponse user) => new(HttpStatus.Created, user, null);
+
+    /// <summary>Records a rejected request.</summary>
+    /// <param name="problem">Problem details describing the rejection.</param>
+    /// <returns>A response carrying the problem status code and no user.</returns>
+    public static EndpointResponse FromProblem(ProblemResponse problem) => new(problem.Status, null, problem);
+}
+
+/// <summary>Create-user endpoint: parses the request body, validates it, and reports problems.</summary>
+public static class CreateUserEndpoint
+{
+    private static readonly JsonSerializerOptions PayloadOptions = new()
+    {
+        PropertyNameCaseInsensitive = true,
+    };
+
+    /// <summary>Handles a create-user request body.</summary>
+    /// <param name="requestBody">Raw request body, or <see langword="null"/> when the caller sent none.</param>
+    /// <returns>A 201 response with the created user, or a 400 problem response for invalid input.</returns>
+    public static EndpointResponse Handle(string? requestBody)
+    {
+        if (string.IsNullOrWhiteSpace(requestBody))
+        {
+            return EndpointResponse.FromProblem(ProblemResponse.MissingBody());
+        }
+
+        CreateUserRequest? request;
+        try
+        {
+            request = JsonSerializer.Deserialize<CreateUserRequest>(requestBody, PayloadOptions);
+        }
+        catch (JsonException)
+        {
+            return EndpointResponse.FromProblem(ProblemResponse.MalformedBody());
+        }
+
+        if (request is null)
+        {
+            return EndpointResponse.FromProblem(ProblemResponse.MissingBody());
+        }
+
+        var errors = Validator.ValidateFields(request);
+        if (errors.Count > 0)
+        {
+            return EndpointResponse.FromProblem(ProblemResponse.FromValidationErrors(errors));
+        }
+
+        if (request.Email is not { } email || request.Name is not { } name)
+        {
+            return EndpointResponse.FromProblem(ProblemResponse.MalformedBody());
+        }
+
+        return EndpointResponse.Created(new CreateUserResponse(email, name, request.Age));
+    }
+}
