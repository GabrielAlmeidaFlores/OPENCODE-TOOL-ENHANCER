+using System.Text.Json;
+using Example;
+using Xunit;
+
+namespace Example.Tests;
+
+/// <summary>Tests for <see cref="CreateUserEndpoint"/> payload handling and problem responses.</summary>
+public class EndpointTests
+{
+    private const string ValidPayload = """{"email":"ada@example.com","name":"Ada","age":30}""";
+
+    private const string ValidPayloadWithoutAge = """{"email":"ada@example.com","name":"Ada"}""";
+
+    private const string ValidPayloadWithUpperCasedFields = """{"EMAIL":"ada@example.com","NAME":"Ada","AGE":30}""";
+
+    private const string ValidPayloadWithUnknownField = """{"email":"ada@example.com","name":"Ada","age":30,"role":"admin"}""";
+
+    private const string InvalidPayload = """{"email":"not-an-email","name":"   ","age":-1}""";
+
+    private const string EmptyPayload = "";
+
+    private const string WhitespacePayload = "   ";
+
+    private const string JsonNullPayload = "null";
+
+    private const string TruncatedJsonPayload = """{"email":"ada@example.com","name":""";
+
+    private const string ArrayPayload = """[1,2,3]""";
+
+    private const string ScalarJsonPayload = "\"ada\"";
+
+    private const string TypeMismatchPayload = """{"email":"ada@example.com","name":"Ada","age":"thirty"}""";
+
+    /// <summary>Verifies that a valid payload yields the created user and no problem.</summary>
+    [Fact]
+    public void AcceptsValidPayload()
+    {
+        var response = CreateUserEndpoint.Handle(ValidPayload);
+
+        Assert.Equal(HttpStatus.Created, response.StatusCode);
+        Assert.Null(response.Problem);
+
+        var user = Assert.IsType<CreateUserResponse>(response.User);
+        Assert.Equal("ada@example.com", user.Email);
+        Assert.Equal("Ada", user.Name);
+        Assert.Equal(30, user.Age);
+    }
+
+    /// <summary>Verifies that the optional age may be omitted.</summary>
+    [Fact]
+    public void AcceptsPayloadWithoutAge()
+    {
+        var response = CreateUserEndpoint.Handle(ValidPayloadWithoutAge);
+
+        Assert.Equal(HttpStatus.Created, response.StatusCode);
+
+        var user = Assert.IsType<CreateUserResponse>(response.User);
+        Assert.Null(user.Age);
+    }
+
+    /// <summary>Verifies that JSON field names are matched without regard to case.</summary>
+    [Fact]
+    public void AcceptsDifferentlyCasedFieldNames()
+    {
+        var response = CreateUserEndpoint.Handle(ValidPayloadWithUpperCasedFields);
+
+        Assert.Equal(HttpStatus.Created, response.StatusCode);
+
+        var user = Assert.IsType<CreateUserResponse>(response.User);
+        Assert.Equal("ada@example.com", user.Email);
+    }
+
+    /// <summary>Verifies that fields the endpoint does not model are ignored.</summary>
+    [Fact]
+    public void IgnoresUnknownFields()
+    {
+        var response = CreateUserEndpoint.Handle(ValidPayloadWithUnknownField);
+
+        Assert.Equal(HttpStatus.Created, response.StatusCode);
+        Assert.Null(response.Problem);
+    }
+
+    /// <summary>Verifies that a missing payload returns a 400 problem response instead of throwing.</summary>
+    /// <param name="payload">Request body variants that carry no object.</param>
+    [Theory]
+    [InlineData(null)]
+    [InlineData(EmptyPayload)]
+    [InlineData(WhitespacePayload)]
+    [InlineData(JsonNullPayload)]
+    public void ReturnsMissingBodyProblem(string? payload)
+    {
+        var response = CreateUserEndpoint.Handle(payload);
+
+        var problem = AssertProblem(response, ProblemMessages.MissingBodyType, ProblemMessages.MissingBodyTitle);
+        Assert.Empty(problem.Errors);
+    }
+
+    /// <summary>Verifies that a payload that is not a single JSON object returns a 400 problem response.</summary>
+    /// <param name="payload">Request bodies that cannot be read as one user object.</param>
+    [Theory]
+    [InlineData(TruncatedJsonPayload)]
+    [InlineData(ArrayPayload)]
+    [InlineData(ScalarJsonPayload)]
+    [InlineData(TypeMismatchPayload)]
+    [InlineData("not json at all")]
+    public void ReturnsMalformedBodyProblem(string payload)
+    {
+        var response = CreateUserEndpoint.Handle(payload);
+
+        var problem = AssertProblem(response, ProblemMessages.MalformedBodyType, ProblemMessages.MalformedBodyTitle);
+        Assert.Empty(problem.Errors);
+    }
+
+    /// <summary>Verifies that a well-formed payload with invalid values returns field-keyed errors.</summary>
+    [Fact]
+    public void ReturnsValidationProblemWithFieldErrors()
+    {
+        var response = CreateUserEndpoint.Handle(InvalidPayload);
+
+        var problem = AssertProblem(response, ProblemMessages.ValidationType, ProblemMessages.ValidationTitle);
+
+        var errors = problem.Errors;
+        Assert.Equal(
+            new[] { FieldNames.Age, FieldNames.Email, FieldNames.Name },
+            errors.Keys.OrderBy(key => key, StringComparer.Ordinal));
+        Assert.Equal(new[] { ValidationMessages.EmailInvalid }, errors[FieldNames.Email]);
+        Assert.Equal(new[] { ValidationMessages.NameRequired }, errors[FieldNames.Name]);
+        Assert.Equal(new[] { ValidationMessages.AgeNegative }, errors[FieldNames.Age]);
+    }
+
+    /// <summary>Verifies that the problem payload uses the RFC 7807 property names and the 400 status.</summary>
+    [Fact]
+    public void SerializesProblemWithRfc7807PropertyNames()
+    {
+        var response = CreateUserEndpoint.Handle(null);
+
+        var problem = Assert.IsType<ProblemResponse>(response.Problem);
+        var json = JsonSerializer.Serialize(problem);
+
+        Assert.Contains($"\"{ProblemJsonNames.Type}\":\"{ProblemMessages.MissingBodyType}\"", json);
+        Assert.Contains($"\"{ProblemJsonNames.Status}\":{HttpStatus.BadRequest}", json);
+        Assert.Contains($"\"{ProblemJsonNames.Title}\":\"{ProblemMessages.MissingBodyTitle}\"", json);
+    }
+
+    /// <summary>Asserts that a response carries the expected 400 problem and no user.</summary>
+    /// <param name="response">Response produced by <see cref="CreateUserEndpoint.Handle"/>.</param>
+    /// <param name="expectedType">Expected problem type URI.</param>
+    /// <param name="expectedTitle">Expected problem title.</param>
+    /// <returns>The problem carried by the response, for further assertions.</returns>
+    private static ProblemResponse AssertProblem(EndpointResponse response, string expectedType, string expectedTitle)
+    {
+        Assert.Equal(HttpStatus.BadRequest, response.StatusCode);
+        Assert.Null(response.User);
+
+        var problem = Assert.IsType<ProblemResponse>(response.Problem);
+        Assert.Equal(expectedType, problem.Type);
+        Assert.Equal(expectedTitle, problem.Title);
+        Assert.Equal(HttpStatus.BadRequest, problem.Status);
+        return problem;
+    }
+}
