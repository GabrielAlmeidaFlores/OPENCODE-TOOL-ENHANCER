+/// <summary>RFC 7807 problem details returned when a request cannot be accepted.</summary>
+/// <param name="Type">Problem type URI.</param>
+/// <param name="Title">Short, human-readable summary of the problem type.</param>
+/// <param name="Status">HTTP status code for this occurrence.</param>
+/// <param name="Detail">Human-readable explanation of this occurrence.</param>
+/// <param name="Errors">Validation errors keyed by field name; empty when no field failed.</param>
+public sealed record ProblemResponse(
+    [property: JsonPropertyName(ProblemJsonNames.Type)] string Type,
+    [property: JsonPropertyName(ProblemJsonNames.Title)] string Title,
+    [property: JsonPropertyName(ProblemJsonNames.Status)] int Status,
+    [property: JsonPropertyName(ProblemJsonNames.Detail)] string Detail,
+    [property: JsonPropertyName(ProblemJsonNames.Errors)] IReadOnlyDictionary<string, IReadOnlyList<string>> Errors)
+{
+    private static readonly IReadOnlyDictionary<string, IReadOnlyList<string>> NoFieldErrors =
+        new Dictionary<string, IReadOnlyList<string>>();
+
+    /// <summary>Builds the problem for a request that carried no body.</summary>
+    /// <returns>A 400 problem whose type, title, and detail come from <see cref="ProblemMessages"/>.</returns>
+    public static ProblemResponse MissingBody()
+        => new(
+            ProblemMessages.MissingBodyType,
+            ProblemMessages.MissingBodyTitle,
+            HttpStatus.BadRequest,
+            ProblemMessages.MissingBodyDetail,
+            NoFieldErrors);
+
+    /// <summary>Builds the problem for a body that is not a single JSON object.</summary>
+    /// <returns>A 400 problem whose type, title, and detail come from <see cref="ProblemMessages"/>.</returns>
+    public static ProblemResponse MalformedBody()
+        => new(
+            ProblemMessages.MalformedBodyType,
+            ProblemMessages.MalformedBodyTitle,
+            HttpStatus.BadRequest,
+            ProblemMessages.MalformedBodyDetail,
+            NoFieldErrors);
+
+    /// <summary>Builds the problem for a body whose fields failed validation.</summary>
+    /// <param name="errors">Field-level errors from <see cref="Validator.ValidateFields"/>; must not be empty.</param>
+    /// <returns>A 400 problem that groups the messages by field name.</returns>
+    public static ProblemResponse FromValidationErrors(IReadOnlyList<ValidationError> errors)
+        => new(
+            ProblemMessages.ValidationType,
+            ProblemMessages.ValidationTitle,
+            HttpStatus.BadRequest,
+            ProblemMessages.ValidationDetail,
+            errors
+                .GroupBy(error => error.Field)
+                .ToDictionary(
+                    group => group.Key,
+                    group => (IReadOnlyList<string>)group.Select(error => error.Message).ToList()));
+}
