@@ -0,0 +1,42 @@
+import { validateCreateUser, type CreateUser } from "./validation.js";
+
+/** Body returned when the create-user request is accepted. */
+export interface CreateUserSuccessBody {
+  user: CreateUser;
+}
+
+/** Body returned when the create-user request is rejected. */
+export interface CreateUserErrorBody {
+  error: string;
+  errors: string[];
+}
+
+/** Status and body produced by {@link handleCreateUserRequest}. */
+export interface EndpointResponse {
+  status: 200 | 400;
+  body: CreateUserSuccessBody | CreateUserErrorBody;
+}
+
+const ERROR_INVALID_REQUEST = "invalid request";
+
+/**
+ * Handles a create-user request at the example endpoint boundary.
+ *
+ * @param input - Untrusted request data.
+ * @returns 200 with the created user when valid, otherwise 400 with validation errors.
+ */
+export function handleCreateUserRequest(input: unknown): EndpointResponse {
+  const result = validateCreateUser(input);
+
+  if (!result.ok) {
+    return {
+      status: 400,
+      body: { error: ERROR_INVALID_REQUEST, errors: result.errors },
+    };
+  }
+
+  return {
+    status: 200,
+    body: { user: result.value },
+  };
+}
