--- /dev/null
+++ b/examples/typescript/src/endpoint.test.ts
@@ -0,0 +1,79 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+
+import { handleCreateUserRequest } from "./endpoint.js";
+
+test("returns 200 for a valid request", () => {
+  const response = handleCreateUserRequest({
+    email: "a@b.co",
+    name: "Ada",
+    age: 30,
+  });
+
+  assert.equal(response.status, 200);
+  assert.deepEqual(response.body, {
+    user: { email: "a@b.co", name: "Ada", age: 30 },
+  });
+});
+
+test("returns 400 when the body is not an object", () => {
+  for (const body of [null, undefined, "text", 42, []]) {
+    const response = handleCreateUserRequest(body);
+    assert.equal(response.status, 400);
+  }
+});
+
+test("returns 400 when email is missing", () => {
+  const response = handleCreateUserRequest({ name: "Ada", age: 30 });
+  assert.equal(response.status, 400);
+  assert.match(JSON.stringify(response.body), /email/);
+});
+
+test("returns 400 when email is malformed", () => {
+  for (const email of ["", "ada.example.com", "ada@", "@example.com", 42]) {
+    const response = handleCreateUserRequest({ email, name: "Ada", age: 30 });
+    assert.equal(response.status, 400);
+    assert.match(JSON.stringify(response.body), /email/);
+  }
+});
+
+test("returns 400 when name is missing", () => {
+  const response = handleCreateUserRequest({ email: "a@b.co", age: 30 });
+  assert.equal(response.status, 400);
+  assert.match(JSON.stringify(response.body), /name/);
+});
+
+test("returns 400 when name is malformed", () => {
+  for (const name of ["", "   ", 42, null]) {
+    const response = handleCreateUserRequest({ email: "a@b.co", name, age: 30 });
+    assert.equal(response.status, 400);
+    assert.match(JSON.stringify(response.body), /name/);
+  }
+});
+
+test("returns 400 when age is missing", () => {
+  const response = handleCreateUserRequest({ email: "a@b.co", name: "Ada" });
+  assert.equal(response.status, 400);
+  assert.match(JSON.stringify(response.body), /age/);
+});
+
+test("returns 400 when age is malformed", () => {
+  for (const age of ["30", 30.5, -1, Number.NaN, null]) {
+    const response = handleCreateUserRequest({ email: "a@b.co", name: "Ada", age });
+    assert.equal(response.status, 400);
+    assert.match(JSON.stringify(response.body), /age/);
+  }
+});
+
+test("returns 400 with every validation error at once", () => {
+  const response = handleCreateUserRequest({});
+  assert.equal(response.status, 400);
+  assert.deepEqual(response.body, {
+    error: "invalid request",
+    errors: [
+      "email must be a valid address",
+      "name is required",
+      "age is required",
+    ],
+  });
+});
