// Name: Optional per-agent model routing overlay
// Purpose: Maps planning, implementation, review, and documentation roles to configurable model environment variables.
// Usage: Set every referenced environment variable, then merge these agents entries into .opencode/opencode.jsonc.
// Validation: opencode debug config; ./scripts/validation/validate.sh
// References: https://opencode.ai/docs/agents, https://opencode.ai/docs/models

{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "planner": {
      "model": "{env:OPENCODE_MODEL_PLANNER}"
    },
    "architect": {
      "model": "{env:OPENCODE_MODEL_ARCHITECT}"
    },
    "backend-developer": {
      "model": "{env:OPENCODE_MODEL_IMPLEMENT}"
    },
    "frontend-developer": {
      "model": "{env:OPENCODE_MODEL_IMPLEMENT}"
    },
    "database-specialist": {
      "model": "{env:OPENCODE_MODEL_IMPLEMENT}"
    },
    "code-reviewer": {
      "model": "{env:OPENCODE_MODEL_REVIEW}"
    },
    "security-reviewer": {
      "model": "{env:OPENCODE_MODEL_REVIEW}"
    },
    "performance-analyst": {
      "model": "{env:OPENCODE_MODEL_REVIEW}"
    },
    "documentation-engineer": {
      "model": "{env:OPENCODE_MODEL_DOCS}"
    }
  }
}
