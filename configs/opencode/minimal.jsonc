// Name: OpenCode V2 minimal project configuration
// Purpose: Native tools plus ripgrep and ast-grep, with no MCP servers, for small repositories or constrained environments.
// Usage: Copy to <project>/.opencode/opencode.jsonc when the full profile is unnecessary.
// Validation: opencode debug config; opencode debug agents; ./scripts/validation/validate.sh
// References: https://opencode.ai/docs/config

{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coordinator",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "**/.tmp*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/var/folders/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/var/folders/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git add*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git stage*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git commit*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -C * add*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -C * stage*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -C * commit*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -c * add*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -c * stage*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -c * commit*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git stash*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git checkout*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": ".env*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {}
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000
    },
    "buffer": "15%"
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "experimental": {
    "todo": true,
    "subagent_depth": 1
  }
}
