// Name: OpenCode V2 project configuration
// Purpose: Defines the coordinator agent, safety permissions, MCP servers, context limits, and watcher exclusions for OpenCode 2.2.x.
// Usage: Copy to <project>/.opencode/opencode.jsonc and install the agent, command, and skill files.
// Validation: opencode debug config; opencode debug agents; ./scripts/validation/validate.sh
// References: https://opencode.ai/docs/config, https://opencode.ai/docs/permissions, https://opencode.ai/docs/mcp-servers

{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coordinator",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "**/.tmp*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/var/folders/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/var/folders/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git add*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git stage*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git commit*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -C * add*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -C * stage*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -C * commit*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -c * add*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -c * stage*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git -c * commit*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git stash*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git checkout*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git clean*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push --force*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git push -f*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": ".env*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": ".env*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "timeout": {
      "startup": 45000,
      "catalog": 30000,
      "execution": 600000
    },
    "servers": {
      "serena": {
        "type": "local",
        "command": [
          "serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd"
        ],
        "codemode": true,
        "timeout": {
          "startup": 60000
        }
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "codemode": true,
        "timeout": {
          "startup": 60000
        }
      },
      "repomix": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "repomix",
          "--mcp",
          "--sandbox"
        ],
        "codemode": true,
        "disabled": true
      },
      "jcodemunch": {
        "type": "local",
        "command": [
          "uvx",
          "jcodemunch-mcp"
        ],
        "codemode": true,
        "disabled": true
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 12000
    },
    "buffer": "15%"
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**",
      "**/.next/**",
      "**/target/**",
      "**/bin/**",
      "**/obj/**",
      "**/.codegraph/**",
      "**/.agent/**",
      "**/.ralph/agent/**",
      "repomix-output.*"
    ]
  },
  "experimental": {
    "todo": true,
    "subagent_depth": 1
  }
}
