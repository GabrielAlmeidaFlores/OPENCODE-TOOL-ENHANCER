{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/GabrielAlmeidaFlores/ToolWright/catalog/schema/entry.schema.json",
  "title": "Verified artifact catalog",
  "description": "Generated catalog of agents, skills, commands, and Ralph hats with provenance metadata.",
  "type": "object",
  "required": ["schema_version", "generated_from", "counts", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_from": {
      "type": "string",
      "minLength": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/artifact"
      }
    }
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "type",
        "section",
        "local",
        "source",
        "upstream_path",
        "upstream_commit",
        "license",
        "author",
        "author_url",
        "retrieved",
        "modified"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["agent", "skill", "command", "hat"]},
        "section": {"enum": ["agents", "skills", "commands", "hats"]},
        "local": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "upstream_path": {"type": "string", "minLength": 1},
        "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "license": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "author_url": {"type": "string", "pattern": "^https?://"},
        "retrieved": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "modified": {"type": "string", "minLength": 1}
      }
    }
  }
}
